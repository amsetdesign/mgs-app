# Base Supabase partagée avec l'application mobile (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 : mêmes valeurs que les secrets de la fonction r2-upload-url
NEXT_PUBLIC_R2_PUBLIC_BASE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Adresse publique du site (sitemap, partages)
NEXT_PUBLIC_SITE_URL=https://www.musicgospelsenegal.com
